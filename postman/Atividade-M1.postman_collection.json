      "name": "01 - CRUD e ViaCEP real",
      "item": [
        {
          "name": "01 - Criar produto e salvar ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Produto criado\", function () { const p = pm.response.json(); pm.expect(p.id).to.be.a('string'); pm.expect(p.active).to.eql(true); pm.expect(p.distributionCenter).to.eql('Mogi das Cruzes'); pm.collectionVariables.set('productId', p.id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Produto de teste M1\",\n  \"price\": 12990,\n  \"category\": \"atividade-m1\",\n  \"distributionCenter\": \"Mogi das Cruzes\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 - Listar produtos ativos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Inclui produto criado\", function () { pm.expect(pm.response.json().some(p => p.id === pm.collectionVariables.get('productId'))).to.eql(true); pm.expect(pm.response.json().every(p => p.active)).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
